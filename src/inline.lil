import {
  Flags,
  arrLen,
  isAlnum,
  isAlpha,
  isDigit,
  isWs,
  jsNull,
  normId,
  pushNode,
  unescapeText
} from "./host.lil";
import {
  mdBreak,
  mdDelete,
  mdEmphasis,
  mdHtml,
  mdImage,
  mdImageRef,
  mdInlineCode,
  mdInlineMath,
  mdLink,
  mdLinkRef,
  mdMath,
  mdStrong,
  mdText
} from "./nodes.lil";

export class Cursor {
  string src;
  int pos;
  int len;

  init(string src) {
    this.src = src;
    this.pos = 0;
    this.len = src.length;
  }
}

int peekAt(Cursor c, int offset) {
  int i = c.pos + offset;
  if (i < 0 || i >= c.len) {
    return 0;
  }
  return c.src.charCodeAt(i);
}

int peek(Cursor c) {
  return peekAt(c, 0);
}

bool ended(Cursor c) {
  return c.pos >= c.len;
}

void skipWs(Cursor c) {
  while (!ended(c) && isWs(peek(c))) {
    c.pos = c.pos + 1;
  }
}

int countRun(Cursor c, int code) {
  int n = 0;
  int i = c.pos;
  while (i < c.len && c.src.charCodeAt(i) == code) {
    n = n + 1;
    i = i + 1;
  }
  return n;
}

int findCloseRun(Cursor c, int code, int need, int start) {
  int i = start;
  while (i < c.len) {
    if (c.src.charCodeAt(i) == 92) {
      i = i + 2;
    } else if (c.src.charCodeAt(i) == code) {
      int n = 0;
      int j = i;
      while (j < c.len && c.src.charCodeAt(j) == code) {
        n = n + 1;
        j = j + 1;
      }
      if (n >= need) {
        return i;
      }
      i = j;
    } else {
      i = i + 1;
    }
  }
  return -1;
}

int findChar(Cursor c, int code, int start) {
  int i = start;
  while (i < c.len) {
    int ch = c.src.charCodeAt(i);
    if (ch == 92) {
      i = i + 2;
    } else if (ch == code) {
      return i;
    } else {
      i = i + 1;
    }
  }
  return -1;
}

int findBalanced(Cursor c, int open, int close, int start) {
  int depth = 1;
  int i = start;
  while (i < c.len) {
    int ch = c.src.charCodeAt(i);
    if (ch == 92) {
      i = i + 2;
    } else if (ch == open) {
      depth = depth + 1;
      i = i + 1;
    } else if (ch == close) {
      depth = depth - 1;
      if (depth == 0) {
        return i;
      }
      i = i + 1;
    } else {
      i = i + 1;
    }
  }
  return -1;
}

string sliceTo(Cursor c, int end) {
  return c.src.slice(c.pos, end);
}

bool leftFlank(Cursor c) {
  int next = peekAt(c, 1);
  return next != 0 && !isWs(next);
}

bool canOpenDelim(Cursor c, int code) {
  if (!leftFlank(c)) {
    return false;
  }
  if (code != 95) {
    return true;
  }
  int prev = peekAt(c, -1);
  return prev == 0 || !isAlnum(prev);
}

string textBetween(Cursor c, int from, int to) {
  return c.src.slice(from, to);
}

string altFrom(JsValue children) {
  string out = "";
  int n = arrLen(children);
  int i = 0;
  while (i < n) {
    JsValue node = children[i];
    JsValue t = node["type"];
    if (t is string && t == "text") {
      out = out + asText(node);
    } else if (t is string && t == "inlineCode") {
      out = out + asText(node);
    }
    i = i + 1;
  }
  return out;
}

string asText(JsValue node) {
  JsValue v = node["value"];
  if (v is string) {
    return v;
  }
  return "";
}

void emitAutolinks(JsValue out, string buf, bool gfm) {
  if (!gfm || buf.length == 0) {
    if (buf.length > 0) {
      pushNode(out, mdText(buf));
    }
    return;
  }
  int i = 0;
  int n = buf.length;
  int textStart = 0;
  while (i < n) {
    int hit = -1;
    string scheme = "";
    if (i + 8 <= n && buf.slice(i, i + 8) == "https://") {
      hit = i;
      scheme = "https://";
    } else if (i + 7 <= n && buf.slice(i, i + 7) == "http://") {
      hit = i;
      scheme = "http://";
    } else if (i + 4 <= n && buf.slice(i, i + 4) == "www.") {
      hit = i;
      scheme = "www.";
    }
    if (hit >= 0 && (hit == 0 || !isAlnum(buf.charCodeAt(hit - 1)))) {
      int j = hit + scheme.length;
      while (j < n) {
        int ch = buf.charCodeAt(j);
        if (isWs(ch) || ch == 60 || ch == 62 || ch == 41 || ch == 93) {
          break;
        }
        j = j + 1;
      }
      while (j > hit + scheme.length) {
        int last = buf.charCodeAt(j - 1);
        if (last == 46 || last == 44 || last == 59 || last == 58 || last == 33 || last == 63) {
          j = j - 1;
        } else {
          break;
        }
      }
      if (j > hit + scheme.length) {
        if (hit > textStart) {
          pushNode(out, mdText(buf.slice(textStart, hit)));
        }
        string raw = buf.slice(hit, j);
        string href = raw;
        if (scheme == "www.") {
          href = "http://" + raw;
        }
        JsValue kids = JS.array();
        pushNode(kids, mdText(raw));
        pushNode(out, mdLink(href, jsNull(), kids));
        textStart = j;
        i = j;
        continue;
      }
    }
    i = i + 1;
  }
  if (textStart < n) {
    pushNode(out, mdText(buf.slice(textStart)));
  }
}

void flushText(JsValue out, string buf, bool gfm) {
  emitAutolinks(out, buf, gfm);
}

string parseDestination(Cursor c) {
  skipWs(c);
  if (ended(c)) {
    return "";
  }
  if (peek(c) == 60) {
    c.pos = c.pos + 1;
    int close = findChar(c, 62, c.pos);
    if (close < 0) {
      return "";
    }
    string url = textBetween(c, c.pos, close);
    c.pos = close + 1;
    return unescapeText(url);
  }
  int start = c.pos;
  int depth = 0;
  while (!ended(c)) {
    int ch = peek(c);
    if (isWs(ch)) {
      break;
    }
    if (ch == 40) {
      depth = depth + 1;
    }
    if (ch == 41) {
      if (depth == 0) {
        break;
      }
      depth = depth - 1;
    }
    if (ch == 92) {
      c.pos = c.pos + 2;
    } else {
      c.pos = c.pos + 1;
    }
  }
  return unescapeText(c.src.slice(start, c.pos));
}

JsValue parseTitle(Cursor c) {
  skipWs(c);
  if (ended(c)) {
    return jsNull();
  }
  int q = peek(c);
  if (q != 34 && q != 39 && q != 40) {
    return jsNull();
  }
  int close = 34;
  if (q == 39) {
    close = 39;
  }
  if (q == 40) {
    close = 41;
  }
  c.pos = c.pos + 1;
  int start = c.pos;
  int end = findChar(c, close, c.pos);
  if (end < 0) {
    return jsNull();
  }
  string title = unescapeText(c.src.slice(start, end));
  c.pos = end + 1;
  return title;
}

JsValue parseLinkBody(Cursor c, int labelEnd, bool image, Flags flags, Map<string, JsValue> defs) {
  string label = c.src.slice(c.pos, labelEnd);
  Cursor inner = new Cursor(label);
  JsValue children = parseInlinesTo(inner, label.length, flags, defs);
  int after = labelEnd + 1;
  if (after < c.len && c.src.charCodeAt(after) == 40) {
    int saved = c.pos;
    c.pos = after + 1;
    string url = parseDestination(c);
    JsValue title = parseTitle(c);
    skipWs(c);
    if (!ended(c) && peek(c) == 41) {
      c.pos = c.pos + 1;
      if (image) {
        return mdImage(url, title, altFrom(children));
      }
      return mdLink(url, title, children);
    }
    c.pos = saved;
  }
  if (after < c.len && c.src.charCodeAt(after) == 91) {
    if (after + 1 < c.len && c.src.charCodeAt(after + 1) == 93) {
      string id = normId(label);
      JsValue? def = defs.get(id);
      string refType = "collapsed";
      c.pos = after + 2;
      if (image) {
        return mdImageRef(id, label, refType, altFrom(children));
      }
      return mdLinkRef(id, label, refType, children);
    }
    int refEnd = findBalanced(c, 91, 93, after + 1);
    if (refEnd >= 0) {
      string raw = c.src.slice(after + 1, refEnd);
      string id = normId(raw);
      c.pos = refEnd + 1;
      if (image) {
        return mdImageRef(id, raw, "full", altFrom(children));
      }
      return mdLinkRef(id, raw, "full", children);
    }
  }
  string id = normId(label);
  JsValue? def = defs.get(id);
  if (def != null) {
    JsValue d = def;
    c.pos = after;
    string url = asTextUrl(d);
    JsValue title = d["title"];
    if (image) {
      return mdImage(url, title, altFrom(children));
    }
    return mdLink(url, title, children);
  }
  return JS.undefined();
}

string asTextUrl(JsValue def) {
  JsValue u = def["url"];
  if (u is string) {
    return u;
  }
  return "";
}

JsValue tryAutolink(Cursor c, Flags flags) {
  if (peek(c) != 60) {
    return JS.undefined();
  }
  int close = findChar(c, 62, c.pos + 1);
  if (close < 0) {
    return JS.undefined();
  }
  string inner = c.src.slice(c.pos + 1, close);
  if (inner.length == 0 || inner.includes(" ")) {
    return JS.undefined();
  }
  bool url = inner.startsWith("http://") || inner.startsWith("https://") || inner.startsWith("mailto:") || inner.startsWith("ftp://");
  bool mail = inner.includes("@") && !inner.includes("/");
  if (url || mail) {
    string href = inner;
    if (mail && !inner.startsWith("mailto:")) {
      href = "mailto:" + inner;
    }
    JsValue kids = JS.array();
    pushNode(kids, mdText(inner));
    c.pos = close + 1;
    return mdLink(href, jsNull(), kids);
  }
  if (flags.allowDangerousHtml && isAlpha(inner.charCodeAt(0))) {
    string raw = c.src.slice(c.pos, close + 1);
    c.pos = close + 1;
    return mdHtml(raw);
  }
  return JS.undefined();
}

JsValue tryHtml(Cursor c, Flags flags) {
  if (peek(c) != 60 || !flags.allowDangerousHtml) {
    return JS.undefined();
  }
  int end = findChar(c, 62, c.pos + 1);
  if (end < 0) {
    return JS.undefined();
  }
  int second = peekAt(c, 1);
  if (second == 47 || second == 33 || second == 63 || isAlpha(second)) {
    string raw = c.src.slice(c.pos, end + 1);
    c.pos = end + 1;
    return mdHtml(raw);
  }
  return JS.undefined();
}

JsValue tryCode(Cursor c) {
  if (peek(c) != 96) {
    return JS.undefined();
  }
  int ticks = countRun(c, 96);
  int search = c.pos + ticks;
  while (search < c.len) {
    if (c.src.charCodeAt(search) == 96) {
      int n = 0;
      int j = search;
      while (j < c.len && c.src.charCodeAt(j) == 96) {
        n = n + 1;
        j = j + 1;
      }
      if (n == ticks) {
        string raw = c.src.slice(c.pos + ticks, search);
        if (raw.length >= 2 && raw.startsWith(" ") && raw.endsWith(" ") && raw.trim().length > 0) {
          raw = raw.slice(1, raw.length - 1);
        }
        Regex nl = new Regex("\n", "g");
        nl.lastIndex = 0;
        raw = raw.replace(nl, " ");
        c.pos = j;
        return mdInlineCode(raw);
      }
      search = j;
    } else {
      search = search + 1;
    }
  }
  return JS.undefined();
}

JsValue tryMath(Cursor c, Flags flags) {
  if (!flags.math || peek(c) != 36) {
    return JS.undefined();
  }
  int dollars = countRun(c, 36);
  if (dollars >= 2) {
    int close = findCloseRun(c, 36, 2, c.pos + dollars);
    if (close >= 0) {
      string raw = c.src.slice(c.pos + dollars, close);
      c.pos = close + 2;
      return mdMath(raw.trim());
    }
  }
  int next = peekAt(c, 1);
  if (next == 0 || isWs(next) || next == 36) {
    return JS.undefined();
  }
  int close = findChar(c, 36, c.pos + 1);
  if (close < 0) {
    return JS.undefined();
  }
  if (isWs(c.src.charCodeAt(close - 1))) {
    return JS.undefined();
  }
  string raw = c.src.slice(c.pos + 1, close);
  c.pos = close + 1;
  return mdInlineMath(raw);
}

JsValue tryDelete(Cursor c, Flags flags) {
  if (!flags.gfm || peek(c) != 126) {
    return JS.undefined();
  }
  int tildes = countRun(c, 126);
  int need = 2;
  if (flags.singleTilde && tildes == 1) {
    need = 1;
  }
  if (tildes < need) {
    return JS.undefined();
  }
  int close = findCloseRun(c, 126, need, c.pos + tildes);
  if (close < 0) {
    return JS.undefined();
  }
  string inner = c.src.slice(c.pos + need, close);
  Cursor sub = new Cursor(inner);
  JsValue kids = parseInlinesTo(sub, inner.length, flags, new Map<string, JsValue>());
  c.pos = close + need;
  return mdDelete(kids);
}

JsValue tryEmphasis(Cursor c, Flags flags, Map<string, JsValue> defs) {
  int code = peek(c);
  if (code != 42 && code != 95) {
    return JS.undefined();
  }
  if (!canOpenDelim(c, code)) {
    return JS.undefined();
  }
  int run = countRun(c, code);
  int close = findCloseRun(c, code, 1, c.pos + run);
  if (close < 0) {
    return JS.undefined();
  }
  int take = 1;
  int closeRun = 0;
  int k = close;
  while (k < c.len && c.src.charCodeAt(k) == code) {
    closeRun = closeRun + 1;
    k = k + 1;
  }
  if (run >= 2 && closeRun >= 2) {
    take = 2;
  }
  string inner = c.src.slice(c.pos + take, close);
  Cursor sub = new Cursor(inner);
  JsValue kids = parseInlinesTo(sub, inner.length, flags, defs);
  c.pos = close + take;
  if (take == 2) {
    return mdStrong(kids);
  }
  return mdEmphasis(kids);
}

JsValue parseInlinesTo(Cursor c, int limit, Flags flags, Map<string, JsValue> defs) {
  JsValue out = JS.array();
  string buf = "";
  int end = limit;
  if (end > c.len) {
    end = c.len;
  }
  while (c.pos < end) {
    int ch = peek(c);
    if (ch == 92) {
      int next = peekAt(c, 1);
      if (next == 10) {
        flushText(out, buf, flags.gfm);
        buf = "";
        pushNode(out, mdBreak());
        c.pos = c.pos + 2;
      } else if (next != 0) {
        buf = buf + c.src.charAt(c.pos + 1);
        c.pos = c.pos + 2;
      } else {
        buf = buf + "\\";
        c.pos = c.pos + 1;
      }
      continue;
    }
    if (ch == 10) {
      flushText(out, buf, flags.gfm);
      buf = "";
      int prev = peekAt(c, -1);
      int prev2 = peekAt(c, -2);
      if (prev == 32 && prev2 == 32) {
        pushNode(out, mdBreak());
      } else if (flags.breaks) {
        pushNode(out, mdBreak());
      } else {
        buf = buf + "\n";
      }
      c.pos = c.pos + 1;
      continue;
    }
    if (ch == 96) {
      JsValue code = tryCode(c);
      if (!JS.isUndefined(code)) {
        flushText(out, buf, flags.gfm);
        buf = "";
        pushNode(out, code);
        continue;
      }
    }
    if (ch == 36) {
      JsValue math = tryMath(c, flags);
      if (!JS.isUndefined(math)) {
        flushText(out, buf, flags.gfm);
        buf = "";
        pushNode(out, math);
        continue;
      }
    }
    if (ch == 60) {
      JsValue linked = tryAutolink(c, flags);
      if (!JS.isUndefined(linked)) {
        flushText(out, buf, flags.gfm);
        buf = "";
        pushNode(out, linked);
        continue;
      }
      JsValue html = tryHtml(c, flags);
      if (!JS.isUndefined(html)) {
        flushText(out, buf, flags.gfm);
        buf = "";
        pushNode(out, html);
        continue;
      }
    }
    if (ch == 33 && peekAt(c, 1) == 91) {
      int close = findBalanced(c, 91, 93, c.pos + 2);
      if (close >= 0) {
        int saved = c.pos;
        c.pos = c.pos + 2;
        JsValue node = parseLinkBody(c, close, true, flags, defs);
        if (!JS.isUndefined(node)) {
          flushText(out, buf, flags.gfm);
          buf = "";
          pushNode(out, node);
          continue;
        }
        c.pos = saved;
      }
    }
    if (ch == 91) {
      int close = findBalanced(c, 91, 93, c.pos + 1);
      if (close >= 0) {
        int saved = c.pos;
        c.pos = c.pos + 1;
        JsValue node = parseLinkBody(c, close, false, flags, defs);
        if (!JS.isUndefined(node)) {
          flushText(out, buf, flags.gfm);
          buf = "";
          pushNode(out, node);
          continue;
        }
        c.pos = saved;
      }
    }
    if (ch == 126) {
      JsValue del = tryDelete(c, flags);
      if (!JS.isUndefined(del)) {
        flushText(out, buf, flags.gfm);
        buf = "";
        pushNode(out, del);
        continue;
      }
    }
    if (ch == 42 || ch == 95) {
      JsValue em = tryEmphasis(c, flags, defs);
      if (!JS.isUndefined(em)) {
        flushText(out, buf, flags.gfm);
        buf = "";
        pushNode(out, em);
        continue;
      }
    }
    buf = buf + c.src.charAt(c.pos);
    c.pos = c.pos + 1;
  }
  flushText(out, buf, flags.gfm);
  return out;
}

export JsValue parseInlines(string src, Flags flags, Map<string, JsValue> defs) {
  Cursor c = new Cursor(src);
  return parseInlinesTo(c, src.length, flags, defs);
}
